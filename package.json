{
  "name": "maple-bowl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:content && npm run validate:messages && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:m3": "prettier --write \"app/[locale]/brands/**/*.tsx\" \"app/[locale]/food/**/*.tsx\" \"app/[locale]/ingredients/**/*.tsx\" \"app/[locale]/nutrition-guide/**/*.tsx\" \"components/content/content-status-badge.tsx\" \"components/product/**/*.tsx\" \"content/nutrition-topics/index.ts\" \"lib/content*.ts\" \"lib/types.ts\" \"scripts/**/*.ts\" \"messages/*.json\" \"package.json\" \"next.config.ts\" \"tsconfig.json\" \"MVP-ROADMAP.md\"",
    "format:check:m3": "prettier --check \"app/[locale]/brands/**/*.tsx\" \"app/[locale]/food/**/*.tsx\" \"app/[locale]/ingredients/**/*.tsx\" \"app/[locale]/nutrition-guide/**/*.tsx\" \"components/content/content-status-badge.tsx\" \"components/product/**/*.tsx\" \"content/nutrition-topics/index.ts\" \"lib/content*.ts\" \"lib/types.ts\" \"scripts/**/*.ts\" \"messages/*.json\" \"package.json\" \"next.config.ts\" \"tsconfig.json\" \"MVP-ROADMAP.md\"",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:messages": "tsx scripts/validate-messages.ts",
    "test:content": "tsx scripts/test-content.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.38.0",
    "next": "16.3.3",
    "next-intl": "^4.14.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.9.6",
    "shadcn": "^4.19.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
